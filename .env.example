# 헤뤼싀 서버 프록시(/api/chat)용 환경변수

# 필수: Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 배포한 주소가 공개일 때 아무나 쓰지 못하게 막는 접속 코드.
# 설정하면 앱 설정 화면에서 같은 코드를 입력해야 대화가 됩니다.
ACCESS_CODE=

# 선택: 기본 모델 (미설정 시 claude-opus-5)
HERUSHI_MODEL=claude-opus-5

# 선택: 구글 캘린더·지메일 연결용 OAuth 클라이언트
# (구글 클라우드 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID → 웹 애플리케이션)
# 승인된 리디렉션 URI 에 배포 주소를 그대로 넣어야 합니다. 예: https://myagent.vercel.app/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: 헤뤼싀가 먼저 말을 걸게 하려면 (아침 브리핑 알림)
# 1) VAPID 키 만들기:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# 2) 구독을 저장할 곳. Vercel KV 나 Upstash Redis 를 연결하면 자동으로 들어옵니다.
#    (KV_REST_API_* 또는 UPSTASH_REDIS_REST_* 중 아무 쌍이나)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 3) 크론이 부르는 것만 받도록 (Vercel 이 자동으로 이 토큰을 붙입니다)
CRON_SECRET=
