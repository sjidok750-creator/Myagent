# 헤뤼싀 서버 프록시(/api/chat)용 환경변수

# 필수: Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 배포한 주소가 공개일 때 아무나 쓰지 못하게 막는 접속 코드.
# 설정하면 앱 설정 화면에서 같은 코드를 입력해야 대화가 됩니다.
ACCESS_CODE=

# 선택: 기본 모델 (미설정 시 claude-opus-5)
HERUSHI_MODEL=claude-opus-5

# 선택: 구글 캘린더·지메일 연결용 OAuth 클라이언트
# (구글 클라우드 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID → 웹 애플리케이션)
# 승인된 리디렉션 URI 에 배포 주소를 그대로 넣어야 합니다. 예: https://myagent.vercel.app/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
